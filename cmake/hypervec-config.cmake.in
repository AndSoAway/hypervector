@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(OpenMP COMPONENTS CXX)
find_dependency(BLAS)
find_dependency(LAPACK)

if(NOT TARGET BLAS::BLAS)
  add_library(BLAS::BLAS INTERFACE IMPORTED)
  set_property(TARGET BLAS::BLAS PROPERTY
    INTERFACE_LINK_LIBRARIES "${BLAS_LIBRARIES}")
endif()

if(NOT TARGET LAPACK::LAPACK)
  add_library(LAPACK::LAPACK INTERFACE IMPORTED)
  set_property(TARGET LAPACK::LAPACK PROPERTY
    INTERFACE_LINK_LIBRARIES "${LAPACK_LIBRARIES}")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/hypervec-targets.cmake")

if(NOT TARGET hypervec)
  add_library(hypervec INTERFACE IMPORTED)
  set_property(TARGET hypervec PROPERTY
    INTERFACE_LINK_LIBRARIES hypervec::hypervec)
endif()

check_required_components(hypervec)
